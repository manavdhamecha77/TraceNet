# Copy this file to backend/.env and fill in the values. backend/.env is git-ignored — never commit it.

# --- AWS S3 shared storage (models + videos) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=
# Media store for videos + model weights: auto (S3 when the keys above are set) | s3 | local
MEDIA_STORE=auto

# --- Optional: cloud translation for multilingual search (Settings > Language) ---
OPENROUTER_API_KEY=

# --- Login / roles (Operator, Admin) ---
# AUTH_ENABLED=false disables login (development only). AUTH_SECRET signs sessions; leave empty to let the
# server generate one in backend/data/.auth_secret (machine-local, never synced).
AUTH_ENABLED=true
AUTH_SECRET=

# --- Compute device: auto (GPU if available, else CPU) | cpu | cuda | cuda:1 | mps ---
TRACENET_DEVICE=auto
